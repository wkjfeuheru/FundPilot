# AI 服务环境配置（复制为 .env 后填写；无 Key 时自动走 Stub 演示模式）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Java 后端 tool API 地址（AI 只读回查，不直连业务库，AD-03/AD-04）
TOOL_API_BASE=http://localhost:8080/api/v1

# LLM 流式超时阈值（秒），超时后降级关键词路由（需求 7.3）
LLM_TIMEOUT_SECONDS=10

# 内部调用鉴权令牌（web-ai-tougu agent 模块调用时携带）
INTERNAL_TOKEN=dev-internal-token

# 服务端口
AGENT_PORT=8000
